<div class="side">
  <section class="panel">
    <h2>Preview</h2>
    <div class="preview">
      <div
        class="avatar"
        id="pAvatar"
      >
        B
      </div>
      <div class="body">
        <div class="meta">
          <span
            class="name"
            id="pName"
            >Your bot</span
          >
          <span
            class="tag"
            id="pTag"
            >APP</span
          >
          <span
            class="time"
            id="pTime"
          ></span>
        </div>
        <div
          class="md"
          id="pMd"
        >
        </div>
        <div
          class="embed"
          id="pEmbed"
          hidden
        >
          <div
            class="t"
            id="pET"
          >
          </div>
          <div
            class="md"
            id="pED"
          >
          </div>
          <img
            class="big"
            id="pEI"
            alt=""
            hidden
          />
          <div
            class="f"
            id="pEF"
          >
          </div>
        </div>
      </div>
    </div>

    <button
      class="send"
      id="send"
      type="button"
      >Send message</button
    >
    <div
      class="status"
      id="status"
      role="status"
    >
    </div>
    <p class="hint">
      Tip: Ctrl+Enter (or Cmd+Enter) sends from the text box. The preview is
      close to Discord's rendering but not identical.
    </p>
  </section>
</div>
